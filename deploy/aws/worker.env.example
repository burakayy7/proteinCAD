# proteinCAD worker settings, read by both systemd units on the GPU box.
#
# setup.sh copies this to /etc/proteincad/worker.env and fills the token in.
# Edit that copy, not this one, then:  systemctl restart proteincad-worker
#
# Nothing here is baked into the units, so moving to a different instance type,
# a different checkout or a different interpreter is an edit to this one file.

# Must match PROTEINCAD_EC2_TOKEN (or PROTEINCAD_COMPUTE_TOKEN) on the app side.
# Anyone who can reach the port and has this can queue jobs on your GPU.
PROTEINCAD_WORKER_TOKEN=

# The port the worker listens on. Must match PROTEINCAD_EC2_PORT on the app side
# and be open in the instance's security group.
PROTEINCAD_WORKER_PORT=8000

# Which generator to serve. `rfdiffusion` is the real pipeline -- both stages.
# `echo` needs no GPU and no models; use it once to prove the app can reach the
# box before spending an hour on the install.
# Both engines, if ESM3 is installed on this box as well:
#   PROTEINCAD_WORKER_ARGS=--generator rfdiffusion,esm3
PROTEINCAD_WORKER_ARGS=--generator rfdiffusion

# ESM3's weights are public, so no token is needed. Set one only if the
# anonymous hub download gets rate-limited, which it can on a box that gets a
# fresh address every boot.
# HF_TOKEN=hf_...

# Where the models live and what runs them.
RFDIFFUSION_DIR=/opt/proteincad/RFdiffusion
PROTEINMPNN_DIR=/opt/proteincad/ProteinMPNN
RFDIFFUSION_PYTHON=/opt/proteincad/env/bin/python

# The watchdog on the box: power off after this many seconds with no job and
# nobody asking. This is the backstop that still works when the app has crashed
# or the laptop has closed, so it is deliberately longer than the app's own
# idle timer (PROTEINCAD_EC2_IDLE, 15 minutes by default).
PROTEINCAD_IDLE_LIMIT=1800

# How long after boot to give the worker before a silent one counts as idle.
# Long enough for a first-run model download; short enough that a box whose
# service is broken does not bill all night.
PROTEINCAD_BOOT_GRACE=1800
